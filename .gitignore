# ---------------------------------------------------------------------------
# Android / Gradle
# ---------------------------------------------------------------------------
# Gradle 用户主目录缓存（构建脚本把 GRADLE_USER_HOME 指向此处，不进仓库）
.gradle-home/
*.apk
*.aab
*.ap_
*.dex
*.class
*.aar
*.jar
!**/libs/*.jar
!gradle/wrapper/gradle-wrapper.jar
bin/
gen/
release/
build/
# CI 与 publish.py 整理产物的目录（.github/workflows/*.yml、tools/publish.py）
dist/
.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
local.properties

# tools/ 下的 python 脚本被 import 时会留下这些
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# 签名与凭据 —— 绝对不要提交
# ---------------------------------------------------------------------------
*.keystore
*.jks
keystore.properties
*.p12
*.pem
*.key

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.hprof
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 调试产物（tools/ 下的设备调试脚本会生成）
# ---------------------------------------------------------------------------
/tools/**/build/
/tools/**/out/
/tools/**/logs/
/tools/**/shots/
/tools/**/lspd_db/
/tools/**/recon_out/
/tools/**/ui_tmp.xml
/tools/**/ui_dump.xml
/tools/**/ui_stg.xml
/.work/

# ---------------------------------------------------------------------------
# 工具本地状态（不是项目源码，不进仓库）
# ---------------------------------------------------------------------------
# WorkBuddy 会话记忆与工作日志
.workbuddy/
# 旧版记忆目录（内容已归档到 .workbuddy/memory/archive/）
.workbuddy-ai/
# CodeGraph 代码索引（本地生成，不进仓库）
/.codegraph/
# CodeGraph 生成的 agent 说明（内容与全局 AGENTS.md 重复，属本机工具文件）
/AGENTS.md
# 会话断点台账（按全局 AGENTS.md 协议维护的本地工作日志）
/PROGRESS.md
# DSH 文件认领插件（多会话写域锁）的本机产物
.dsh-file-claim.audit.jsonl
*.dshclaim
# ZCode 本地插件配置（只对本机生效）
/.zcode/

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
# 构建缓存重定向到仓内时用的目录（见 docs/BUILD.md §1 的 env 写法）
/.gradle-home/
/.tmp/
*.log
*.tmp
*.bak
*.orig
*.rej
