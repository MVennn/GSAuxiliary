# ---------------------------------------------------------------------------
# Android / Gradle
# ---------------------------------------------------------------------------
*.apk
*.aab
*.ap_
*.dex
*.class
*.aar
*.jar
!**/libs/*.jar
!gradle/wrapper/gradle-wrapper.jar
bin/
gen/
release/
build/
# CI 与 publish.py 整理产物的目录（.github/workflows/*.yml、tools/publish.py）
dist/
.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
local.properties

# tools/ 下的 python 脚本被 import 时会留下这些
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# 签名与凭据 —— 绝对不要提交
# ---------------------------------------------------------------------------
*.keystore
*.jks
keystore.properties
*.p12
*.pem
*.key

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.hprof
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 调试产物（tools/ 下的设备调试脚本会生成）
# ---------------------------------------------------------------------------
/tools/**/build/
/tools/**/out/
/tools/**/logs/
/tools/**/shots/
/tools/**/lspd_db/
/tools/**/recon_out/
/tools/**/ui_tmp.xml
/tools/**/ui_dump.xml
/tools/**/ui_stg.xml
/.work/

# ---------------------------------------------------------------------------
# 工具本地状态（不是项目源码，不进仓库）
# ---------------------------------------------------------------------------
# WorkBuddy 会话记忆与工作日志
.workbuddy/
# 旧版记忆目录（内容已归档到 .workbuddy/memory/archive/）
.workbuddy-ai/
# CodeGraph 代码索引（本地生成，不进仓库）
/.codegraph/
# ZCode 本地插件配置（只对本机生效）
/.zcode/

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
