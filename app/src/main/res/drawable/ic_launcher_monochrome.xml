<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标的单色层（Android 13+ 主题图标用）。

    系统会忽略这里的填充色、只取 alpha 做剪影，所以整层统一用一个颜色。
    几何与 `ic_launcher_foreground.xml` **完全一致**，只是把渐变描边换成纯白描边 ——
    主题图标下底由系统上色，图形本身必须是无色剪影。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M31,70.5 L44,55.5 L55.5,62 L77,37.5 M67.5,37.5 L77,37.5 L77,47" />
</vector>
