<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标的前景层 —— 一道上扬的弧线，顶端一个实心三角箭镞。

    设计说明
    logo 从「涨—跌—涨」的行情折线换成一笔向右上的弧线 + 箭镞。折线在图标尺寸下
    会多出一个 V 形回踩，缩到任务栏大小就糊成一团；一根弧线只有一次转向，任何尺寸
    都读得出「往上走」。配色沿用旧的方案：深炭灰底 + 浅金到深橙的斜向渐变。

    几何（108×108 画布）
      弧线：M33.08,75.39 Q67.4,75.39 67.4,50.94   二次贝塞尔，起笔水平、收笔竖直
      箭镞：M67.4,29.79 L57.06,50.94 L77.74,50.94 Z  底边中点正是弧线收笔点
      线宽 8.46、箭镞描边 2.82（只用来把三个角磨圆）

    坐标来自设计源图 rise-1x1.svg 的 240 网格，经源图自身的 mask 分组
    （translate(120 120) scale(0.595) translate(-129 -113)）后再乘 0.395 收到 108 网格。
    0.395 是安全区拟合系数：图形外接圆半径落在 34.2，低于自适应图标圆形遮罩的 36，
    圆角桌面不会把起笔那一头切掉。

    与 tools/gen_launcher_icons.py 的一致性
    位图回退（mipmap-*dpi）由该脚本用距离场生成，
    CURVE_START / CURVE_CTRL / CURVE_END / CURVE_STROKE / TRI / TRI_STROKE
    必须与这里逐项对齐；ui/AboutHero.kt 里关于页 mark 的挖空也用同一套坐标。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 弧线：渐变的两个端点就是弧线起笔与箭镞顶端，斜向 -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="8.46"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M33.08,75.39 Q67.4,75.39 67.4,50.94">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="33.08"
                android:startY="75.39"
                android:endX="67.4"
                android:endY="29.79"
                android:startColor="#FFFFC24A"
                android:endColor="#FFFF7A00" />
        </aapt:attr>
    </path>

    <!-- 箭镞：填充 + 同色描边，描边把三个尖角磨圆，和弧线的圆头对得上 -->
    <path
        android:strokeWidth="2.82"
        android:strokeLineJoin="round"
        android:pathData="M67.4,29.79 L57.06,50.94 L77.74,50.94 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33.08"
                android:startY="75.39"
                android:endX="67.4"
                android:endY="29.79"
                android:startColor="#FFFFC24A"
                android:endColor="#FFFF7A00" />
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="33.08"
                android:startY="75.39"
                android:endX="67.4"
                android:endY="29.79"
                android:startColor="#FFFFC24A"
                android:endColor="#FFFF7A00" />
        </aapt:attr>
    </path>
</vector>
