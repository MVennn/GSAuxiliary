<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".app.GszxApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.GSZX">

        <!--
            设置页本体。**始终 enabled**，并且同时声明两个 intent-filter：

              1. MAIN + MODULE_SETTINGS —— LSPosed 模块列表里「打开设置」用的入口。
                 LSPosed 的查找顺序是先找带 `de.robv.android.xposed.category.MODULE_SETTINGS`
                 的 Activity（见 LSPosed ModuleUtil），找不到才回落到 LAUNCHER 图标。
                 把这条声明挂在**本体**而不是 alias 上，是为了让「桌面图标」开关
                 只影响桌面图标，**不影响 LSPosed 里的设置入口**。
              2. 注意这里**不**加 LAUNCHER category —— 桌面图标由下面的 alias 负责。

            另外它必须保持 exported=true：LSPosed 是从自己的进程发起跳转的。
        -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GSZX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
            桌面图标挂在 alias 上，而不是 Activity 本体。
            「桌面图标」开关切换的就是这个 alias 的 enabled 状态；
            Activity 本体始终 enabled，所以关掉图标后仍可由 LSPosed / adb 拉起设置页。
        -->
        <activity-alias
            android:name=".ui.LauncherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            覆盖安装（应用更新）后重新应用「桌面图标」偏好。
            ACTION_MY_PACKAGE_REPLACED 只发给被替换的本包，属于 Android 8.0
            隐式广播限制的豁免场景，可静态注册；exported=false 只收系统/本包。
            覆盖安装会清掉 setComponentEnabledSetting 的组件启用记录，alias 回落到
            manifest 默认（false）；收到广播后按本地镜像重放：关过图标就继续隐藏。
        -->
        <receiver
            android:name=".app.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            宿主策略清单接收器（「从金太阳导入」的数据入口）。

            数据只在宿主进程里（com.guosen.android 的「我的策略」列表），两个进程不同 UID，
            模块 App 读不到宿主的私有 prefs；LSPosed 的 remote preferences 在目标进程侧是只读的，
            宿主也写不回来。所以由宿主 sendBroadcast 到本包，这里静态注册收下、落进本地缓存。
            exported=true 是必须的（发送方是宿主 App），访问控制靠载荷里的固定签名串过滤，
            只收展示用的策略名与 stId，且永远不会覆盖成空清单 —— 见 core/StgCatalogBroadcast。
        -->
        <receiver
            android:name=".app.HostStgCatalogReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.MVennn.GSAuxiliary.action.HOST_STG_CATALOG" />
            </intent-filter>
        </receiver>

        <!--
            adb 调试通道（开发期用，不参与运行期配置读取）。

            运行期配置走 libxposed 的 remote preferences，不再依赖这个 Provider。
            保留它只是为了让 tools/ 下的自动化脚本仍能读写配置，用法见
            docs/TROUBLESHOOTING.md（content query / content update）。
            只接受 root(0) / shell(2000) 写入，其它调用方一律拒绝。

            有意不声明 android:permission：signature 级别的自定义 permission 会把
            adb shell（uid 2000，无 signature 能力）也挡在门外，破坏现有调试通道；
            访问控制完全交给运行时 UID 白名单（见 DebugConfigProvider）。
            也不声明 grantUriPermissions：本 Provider 没有任何临时授权场景
            （脚本直接 content query/update，不经 intent 转发 URI）。
        -->
        <provider
            android:name=".app.DebugConfigProvider"
            android:authorities="io.github.MVennn.GSAuxiliary.config"
            android:exported="true"
            android:enabled="true"
            tools:ignore="ExportedContentProvider" />

        <!--
            注意：现代 API 模块不再使用 legacy meta-data。
            LSPosed 的判定逻辑是「manifest 里出现 xposedminversion 就当 legacy 模块」，
            保留它们反而会让模块被识别成旧式模块、去走 assets/xposed_init 那条路。

            现代模块的元数据改为：
              META-INF/xposed/module.prop     模块属性（minApiVersion / targetApiVersion 等）
              META-INF/xposed/java_init.list  入口类
              META-INF/xposed/scope.list      作用域
            模块名 / 描述取自 android:label / android:description。
        -->
    </application>

</manifest>
