# ---------------------------------------------------------------------------
# GoldSun Probe —— 现代 Xposed API（libxposed）模块属性
#
# 探针是维护者工具，同样按 API 102 规范声明，这样它和主模块走同一条加载链路，
# 不会因为框架升级而失效。
# ---------------------------------------------------------------------------

minApiVersion=102
targetApiVersion=102

# 作用域固定为 scope.list 里声明的应用
staticScope=true

# 探针里大量反射调用，出错时按保护模式处理，避免影响目标 App
exceptionMode=protective
